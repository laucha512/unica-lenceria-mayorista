# Copiá este archivo como .env para desarrollo local con `netlify dev`.
# En producción se cargan en Netlify (Site configuration > Environment variables).

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambiame

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres, aleatorio).
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=
